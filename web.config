<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Activar archivos estáticos -->
    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Documento de inicio -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Compresión GZIP -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Headers de caché y seguridad -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Cache-Control" value="public, max-age=31536000" />
      </customHeaders>
    </httpProtocol>

    <!-- Reescritura de URLs (SPA fallback) -->
    <rewrite>
      <rules>
        <!-- manifest.json: sin caché para que siempre se sirva la versión más reciente -->
        <rule name="No Cache Manifest" stopProcessing="true">
          <match url="^assets/img/gallery/manifest\.json$" />
          <action type="None" />
          <serverVariables>
            <set name="RESPONSE_Cache_Control" value="no-cache, no-store, must-revalidate" />
            <set name="RESPONSE_Pragma" value="no-cache" />
            <set name="RESPONSE_Expires" value="0" />
          </serverVariables>
        </rule>
        <rule name="Static Assets" stopProcessing="true">
          <match url="^assets/.*" />
          <action type="None" />
        </rule>
        <rule name="SPA Fallback">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
